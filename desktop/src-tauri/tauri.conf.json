{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HoriDrive", "version": "0.1.0", "identifier": "io.github.hhhoratioxu.horidrive",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "HoriDrive — Your Cloud. Your Rules.", "width": 1240, "height": 820, "minWidth": 900, "minHeight": 620 }], "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" } },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico", "icons/icon.png"], "shortDescription": "Your Cloud. Your Rules.", "category": "Utility" }
}
